# Copy to .env (never commit .env) and adjust. Every variable is optional;
# values here override the TOML file given via LEDGER_CONFIG / --config.

# Path to a TOML config file
LEDGER_CONFIG=./examples/ledger.toml

# HTTP bind address
LEDGER_BIND=127.0.0.1:8080

# Where the WAL, snapshots, audit log and idempotency store live
LEDGER_DATA_DIR=./data

# WAL durability: always | batch | never
LEDGER_FSYNC=always

# Request body limit in bytes and per-request timeout in seconds
LEDGER_MAX_BODY_BYTES=1048576
LEDGER_REQUEST_TIMEOUT_SECS=30

# Serve /metrics without authentication (true/false)
LEDGER_METRICS_PUBLIC=true

# Automatic snapshot after this many events (0 disables)
LEDGER_SNAPSHOT_EVERY=10000

# Idempotency record lifetime in seconds
LEDGER_IDEMPOTENCY_TTL_SECS=86400

# Logging: tracing filter directive and format (json | pretty)
LEDGER_LOG_LEVEL=info
LEDGER_LOG_FORMAT=json

# API keys as id:role:sha256hex, comma separated. Generate with:
#   cargo run --bin ledgerctl -- hash-key --role admin --id ops
# Roles: reader | writer | admin. Only the SHA-256 hash is configured here;
# the plaintext key is given to the client.
LEDGER_API_KEYS=ops:admin:replace-with-64-hex-chars-from-ledgerctl-hash-key
